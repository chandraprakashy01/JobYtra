# ── Google OAuth2 (Client ID is public — safe to commit) ──────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Set Authorized redirect URI to: http://localhost:5173/oauth2/callback
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── GitHub OAuth2 (Client ID is public — safe to commit) ──────────────────────
# Get from: https://github.com/settings/developers → New OAuth App
# Set Authorization callback URL to: http://localhost:5173/oauth2/callback
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
