# ─── Backend .env ─────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values
# Spring Boot reads these via application.properties ${VAR} placeholders

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/placement_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ── Mail (use Gmail App Password, NOT your real password) ─────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
